{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/downloads/ChatXa-Android-Release.apk",
      "destination": "https://github.com/ashuchinthapalli390-max/how-to-install/releases/download/v4.0.0/ChatXa-Android-Release.apk"
    },
    {
      "source": "/downloads/ChatXa-Android-Release.zip",
      "destination": "https://github.com/ashuchinthapalli390-max/how-to-install/releases/download/v4.0.0/ChatXa-Android-Release.zip"
    },
    {
      "source": "/downloads/ChatXa-iOS-Release.ipa",
      "destination": "https://github.com/ashuchinthapalli390-max/how-to-install/releases/download/v4.0.0/ChatXa-iOS-Release.ipa"
    },
    {
      "source": "/downloads/ChatXa-App-Store.zip",
      "destination": "https://github.com/ashuchinthapalli390-max/how-to-install/releases/download/v4.0.0/ChatXa-App-Store.zip"
    },
    {
      "source": "/((?!downloads|assets|favicon.svg|icons.svg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
